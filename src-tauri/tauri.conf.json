{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sedjem",
  "version": "0.1.0",
  "identifier": "com.sedjem.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Sedjem",
        "url": "index.html",
        "width": 112,
        "height": 112,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "settings",
        "title": "Sedjem",
        "url": "index.html",
        "width": 960,
        "height": 680,
        "minWidth": 780,
        "minHeight": 560,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Floating dictation powered by local Whisper",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/mlx_worker.py"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Sedjem Dev",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2NzM3MTA3ODY0MzdEMkUKUldRdWZVT0dCM0Z6bHNMdHJpRWswSVVpeFBReFMvQ0lHMWJ3MFk4Ymk0ajRCaVVSNTMxTVJLRkUK",
      "endpoints": [
        "https://github.com/enverkaradede/sedjem/releases/latest/download/latest.json"
      ]
    }
  }
}
